manifest {
    name            = 'nf-illumina2lineage'
    author          = 'Abhinav Mishra'
    homePage        = 'https://github.com/bibymaths/nf-illumina2lineage'
    description     = 'SARS-CoV-2 genome assembly and lineage analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.1'
    version         = '0.9.4'
}

params {
  reads        = "*.fastq.gz"
  reference    = "reference.fasta"
  outdir       = "results"
  intermediate = "datafiles"
}

cleanup = true

process {
  executor = 'local'

  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries    = 2

  cpus   = 1
  memory = { 8.GB * task.attempt }
  time   = { 24.h * task.attempt }

  withName: 'downloadData|referenceGenome|consensusGeneration' {
    cpus   = 1
    memory = { 4.GB * task.attempt }
  }

  withName: 'qc' {
    cpus   = 16
    memory = { 16.GB * task.attempt }
  }

  withName: 'mapping' {
    cpus   = 32
    memory = { 32.GB * task.attempt }
  }

  withName: 'primerClipping' {
    cpus   = 16
    memory = { 16.GB * task.attempt }
  }

  withName: 'variantCalling' {
    cpus   = 1
    memory = { 16.GB * task.attempt }
  }

  withName: 'pangolinLineage|consensusQC' {
    cpus   = 8
    memory = { 16.GB * task.attempt }
  }

  withName: 'phylogeny' {
    cpus   = 8
    memory = { 32.GB * task.attempt }
  }
}

report {
  enabled   = true
  file      = "${params.outdir}/report.html"
  overwrite = true
}

timeline {
  enabled   = true
  file      = "${params.outdir}/timeline.html"
  overwrite = true
}

trace {
  enabled   = true
  file      = "${params.outdir}/trace.txt"
  overwrite = true
}

dag {
  enabled   = true
  file      = "${params.outdir}/pipeline_dag.html"
  overwrite = true
}

profiles {
  standard {
    process.executor = 'local'
  }

  pixi {
    process.executor = 'local'

    conda.enabled = false
    docker.enabled = false
    singularity.enabled = false
    podman.enabled = false

    process.beforeScript = """
    export PATH="${projectDir}/.pixi/envs/illumina2lineage/bin:\$PATH"
    """
  }
}